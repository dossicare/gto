# Copy to .env.local for local development, and set the same two values in Vercel
# (Project Settings > Environment Variables). They are read on the server only: there is no
# NEXT_PUBLIC_ prefix on purpose, so they are never sent to visitors' browsers.
# (The old NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY names still work as a fallback.)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ---------------------------------------------------------------------------------------------
# ONLY for the one-off data import (scripts/import_supabase.mjs), run on your own computer.
# Never put this in Vercel and never commit it. It bypasses all access rules.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# ---------------------------------------------------------------------------------------------
