# Copy to .env.local for local development, and set the same two values in Vercel
# (Project Settings > Environment Variables). Both are safe to expose to the browser:
# the database's row-level security decides what they can reach.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ---------------------------------------------------------------------------------------------
# ONLY for the one-off data import (scripts/import_supabase.mjs), run on your own computer.
# Never put this in Vercel and never commit it. It bypasses all access rules.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# ---------------------------------------------------------------------------------------------
